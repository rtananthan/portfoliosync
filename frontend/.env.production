# Production Environment Configuration - v1.0.0
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api-prod.investmenttracker.com.au
VITE_APP_NAME=PortfolioSync
VITE_APP_VERSION=1.0.0

# Production Data Configuration (NO DUMMY DATA)
VITE_USE_MOCK_DATA=false
VITE_AUTH_ENABLED=true
VITE_DEBUG_MODE=false

# Feature Flags for Production
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_BENCHMARKING=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_NEWS_FEED=true
VITE_ENABLE_REAL_TIME_PRICES=true

# Monitoring & Analytics
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_GA_TRACKING_ID=

# Build Configuration
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true

# Support & Branding
VITE_SUPPORT_EMAIL=support@investmenttracker.com.au
VITE_COMPANY_NAME=Investment Tracker Australia