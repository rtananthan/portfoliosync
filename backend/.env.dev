# Development Environment Configuration
STAGE=dev
AWS_REGION=ap-southeast-2

# Authentication Settings
AUTH_ENABLED=false
DEV_MODE=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Validation Settings
VALIDATION_LEVEL=loose

# API Rate Limiting (generous for development)
API_BURST_LIMIT=1000
API_RATE_LIMIT=500

# External API Keys (use placeholders in dev)
ALPHA_VANTAGE_API_KEY=placeholder_key
FINNHUB_API_KEY=placeholder_key
NEWS_API_KEY=placeholder_key

# AI/ML Settings
BEDROCK_REGION=us-east-1

# Cost tracking and monitoring
OWNER_EMAIL=dev@example.com

# Development Security Keys (NOT for production)
JWT_SECRET=dev-jwt-secret-for-local-testing-only
ENCRYPTION_KEY=dev-encryption-key-32-chars-long