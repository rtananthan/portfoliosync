# Production Environment Configuration
STAGE=prod
AWS_REGION=ap-southeast-2

# Authentication Settings (STRICT)
AUTH_ENABLED=true
DEV_MODE=false
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX  # Set via AWS Secrets Manager
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxx     # Set via AWS Secrets Manager

# Validation Settings (STRICT)
VALIDATION_LEVEL=strict

# API Rate Limiting (restrictive for production)
API_BURST_LIMIT=100
API_RATE_LIMIT=50

# External API Keys (loaded from AWS Secrets Manager)
# ALPHA_VANTAGE_API_KEY=  # Retrieved from secrets manager
# FINNHUB_API_KEY=        # Retrieved from secrets manager
# NEWS_API_KEY=           # Retrieved from secrets manager

# AI/ML Settings
BEDROCK_REGION=us-east-1

# Cost tracking and monitoring
OWNER_EMAIL=rtananthan@yahoo.com

# Security Keys (loaded from AWS Secrets Manager)
# JWT_SECRET=     # Retrieved from secrets manager
# ENCRYPTION_KEY= # Retrieved from secrets manager

# Database Encryption
DYNAMODB_ENCRYPTION=true